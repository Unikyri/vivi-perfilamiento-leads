# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Tooling / repo anidado de la wiki (repo aparte)
.atl/
Docs/vivi-perfilamiento-leads.wiki/

# Binarios compilados
bin/

# Frontend build output (pero conservar placeholder para go:embed)
internal/adapters/http/estaticos/*
!internal/adapters/http/estaticos/index.html

# Node
web/node_modules/
web/dist/
